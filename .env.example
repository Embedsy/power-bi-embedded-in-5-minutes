# Service principal (Entra ID app registration) that is a Member/Admin of the workspace.
# In the Power BI admin portal, "Service principals can use Fabric APIs" must allow it.
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=replace-me

# Workspace (group) and report to embed. The workspace must be on a capacity (F/A/P SKU).
WORKSPACE_ID=00000000-0000-0000-0000-000000000000
REPORT_ID=00000000-0000-0000-0000-000000000000

PORT=3000
