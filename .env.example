# Service principal (Entra ID app registration), added as Member or Admin of the workspace.
# Tenant setting "Service principals can use Fabric APIs" must allow it. See 04-service-principal.
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=replace-me

# Workspace and report to embed. The workspace must be on a capacity (F, A or P SKU).
WORKSPACE_ID=00000000-0000-0000-0000-000000000000
REPORT_ID=00000000-0000-0000-0000-000000000000

PORT=3000

# 06-rls and 16-edit-mode: RLS role in the semantic model
RLS_ROLE=Customer

# 08-capacity: the Fabric capacity to pause and resume.
# The service principal needs suspend/resume rights on it in Azure (see 08-capacity/README.md).
SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
RESOURCE_GROUP=my-resource-group
CAPACITY_NAME=mycapacity

# 10-token-refresh: short token lifetime so expiry happens during the demo
TOKEN_LIFETIME_MINUTES=5
