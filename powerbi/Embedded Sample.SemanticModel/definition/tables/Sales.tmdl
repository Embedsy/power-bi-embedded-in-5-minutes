table Sales
	lineageTag: 11ff9f68-afb6-b8b5-b8ed-a218d7c83a65

	measure 'Revenue' = SUM(Sales[Amount])
		formatString: #,0
		lineageTag: d425b8d8-c74e-9365-3c0d-dacafc2c57c3

	measure 'Units' = SUM(Sales[Quantity])
		formatString: #,0
		lineageTag: a24e01d0-da7f-f363-875c-7c93efb6acd7

	measure 'Active Customers' = DISTINCTCOUNT(Sales[CustomerKey])
		formatString: #,0
		lineageTag: a4a63bb1-177c-1547-b281-3603e0cceef6

	measure 'Revenue LY' = CALCULATE([Revenue], SAMEPERIODLASTYEAR('Calendar'[Date]))
		formatString: #,0
		lineageTag: 5fc71d8b-1dde-e675-e862-49a21a56a57b

	measure 'Revenue vs LY' = DIVIDE([Revenue] - [Revenue LY], [Revenue LY])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d2ad01ff-2fc6-a3ae-3015-5269504fe9eb

	column Date
		dataType: dateTime
		isHidden
		formatString: Short Date
		lineageTag: 9eecc081-2b6f-f65e-ca99-f19db073b3fa
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column CustomerKey
		dataType: string
		isHidden
		lineageTag: 2e08d6ba-29a1-0302-e2af-23ef7808176b
		summarizeBy: none
		sourceColumn: CustomerKey

		annotation SummarizationSetBy = Automatic

	column ProductKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 898a46a4-c1c8-d7ac-ebb3-42d7f5600c02
		summarizeBy: none
		sourceColumn: ProductKey

		annotation SummarizationSetBy = Automatic

	column Quantity
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: dfa75dff-4b9e-1c9d-242e-0aff8058bc60
		summarizeBy: sum
		sourceColumn: Quantity

		annotation SummarizationSetBy = Automatic

	column Amount
		dataType: decimal
		isHidden
		formatString: #,0
		lineageTag: 0b770f63-3ebe-a0ad-632d-0d92bdafd7c2
		summarizeBy: sum
		sourceColumn: Amount

		annotation SummarizationSetBy = Automatic

	partition Sales = m
		mode: import
		source =
				// Generated sample data: every customer buys every product every month,
				// with deterministic variation so numbers differ per customer and month.
				let
				    Customers = {{"customer-a", 1.4}, {"customer-b", 1.0}, {"customer-c", 0.8}, {"customer-d", 1.2}, {"customer-e", 0.9}, {"customer-f", 0.6}},
				    Products = {{1, 49, 1.0}, {2, 149, 0.7}, {3, 499, 0.25}, {4, 1200, 0.08}, {5, 900, 0.1}, {6, 300, 0.3}, {7, 99, 0.6}, {8, 29, 1.2}},
				    Months = List.Transform({0..20}, each Date.AddMonths(#date(2025, 1, 1), _)),
				    Rows = List.Combine(List.Transform(Months, (m) =>
				        List.Combine(List.Transform(List.Positions(Customers), (ci) =>
				            List.Transform(List.Positions(Products), (pi) =>
				                let
				                    c = Customers{ci},
				                    p = Products{pi},
				                    i = Date.Year(m) * 12 + Date.Month(m) - 24301,
				                    seed = Number.Mod(ci * 37 + pi * 53 + i * 17, 23),
				                    season = if Date.Month(m) = 12 then 1.3 else if Date.Month(m) = 8 then 0.8 else 1,
				                    qty = Number.RoundUp((3 + seed) * c{1} * p{2} * (1 + i / 40) * season),
				                    day = 1 + Number.Mod(ci * 7 + pi * 3 + i, 27)
				                in
				                    {#date(Date.Year(m), Date.Month(m), day), c{0}, p{0}, qty, qty * p{1}}
				            )
				        ))
				    )),
				    Source = #table(
				        type table [Date = date, CustomerKey = text, ProductKey = Int64.Type, Quantity = Int64.Type, Amount = Currency.Type],
				        Rows
				    )
				in
				    Source

	annotation PBI_ResultType = Table
