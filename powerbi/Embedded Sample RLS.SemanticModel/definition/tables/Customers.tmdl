/// Customers with region and industry, filtered per customer by the Customer RLS role
table Customers
	lineageTag: e6d0e1c8-fc6a-4fcf-4786-9df87e04cd88

	/// Username in the embed token, matched by the Customer RLS role
	column CustomerKey
		dataType: string
		isHidden
		isKey
		lineageTag: 0b4a8278-c5c6-76a4-1cde-f4df1298427f
		summarizeBy: none
		sourceColumn: CustomerKey

		annotation SummarizationSetBy = Automatic

	/// Email of a real user for this customer. Lets "Test as role" in the Power BI
	/// service, which only accepts real users, show the Customer role working.
	column UserEmail
		dataType: string
		isHidden
		lineageTag: 8127885c-3f42-4edd-8070-f76ff9fccd0c
		summarizeBy: none
		sourceColumn: UserEmail

		annotation SummarizationSetBy = Automatic

	column Customer
		dataType: string
		lineageTag: 97a1a16e-738e-8fb9-7fd0-8ed4da3a4999
		summarizeBy: none
		sourceColumn: Customer

		annotation SummarizationSetBy = Automatic

	column Region
		dataType: string
		lineageTag: 052bef2c-4cfa-305c-ec7a-75d1ad491f23
		summarizeBy: none
		sourceColumn: Region

		annotation SummarizationSetBy = Automatic

	column Industry
		dataType: string
		lineageTag: 0f07bc88-121e-7b70-9d60-85a9245e5ca1
		summarizeBy: none
		sourceColumn: Industry

		annotation SummarizationSetBy = Automatic

	partition Customers = m
		mode: import
		source =
				let
				    Source = #table(
				        type table [CustomerKey = text, UserEmail = nullable text, Customer = text, Region = text, Industry = text],
				        {
				        {"customer-a", "vlad@embedsy.io", "Alpine Retail", "Europe", "Retail"},
				        {"customer-b", null, "Bayside Foods", "North America", "Food"},
				        {"customer-c", null, "Cedar Logistics", "Europe", "Logistics"},
				        {"customer-d", null, "Delta Clinics", "Asia Pacific", "Healthcare"},
				        {"customer-e", null, "Evergreen Hotels", "North America", "Hospitality"},
				        {"customer-f", null, "Fjord Energy", "Europe", "Energy"}
				        }
				    )
				in
				    Source

	annotation PBI_ResultType = Table

